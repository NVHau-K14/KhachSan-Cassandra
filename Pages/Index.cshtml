@page
@model IndexModel
@{
    ViewData["Title"] = "Trang Chủ - Đặt phòng khách sạn";
}

<!-- NỬA TRÊN: Banner tìm kiếm -->
<div class="hero-section">
    <div class="hero-overlay"></div>
    <div class="container hero-content">
        <h2 class="text-white text-center fw-bold mb-4" style="text-shadow: 0 2px 4px rgba(0,0,0,0.6);">
            App du lịch hàng đầu, một chạm đi bất cứ đâu
        </h2>

        <div class="search-card p-4 mx-auto" style="max-width: 950px;">
            <div class="d-flex gap-2 mb-3">
                <button type="button" class="btn btn-primary-custom rounded-pill px-3 py-1 btn-sm">
                    <i class="bi bi-building"></i> Khách sạn
                </button>
            </div>

            <form method="get" class="row g-2 align-items-center">
                <!-- Giữ lại SelectedPoi nếu đang lọc theo POI bên dưới -->
                @if (!string.IsNullOrEmpty(Model.SelectedPoi))
                {
                    <input type="hidden" name="SelectedPoi" value="@Model.SelectedPoi" />
                }

                <!-- Ô NHẬP TÌM KIẾM THAY CHO THẺ DROPDOWN -->
                <div class="col-md-5">
                    <label class="form-label fw-bold text-muted small mb-1">Tên khách sạn, địa chỉ</label>
                    <div class="input-group custom-input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                        <input type="text"
                               name="SearchKeyword"
                               class="form-control border-start-0"
                               placeholder="VD: New World, Da Nang, Nguyen Hue..."
                               value="@Model.SearchKeyword" />
                    </div>
                </div>

                <!-- Chọn Ngày nhận phòng -->
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small mb-1">Ngày nhận phòng</label>
                    <div class="input-group custom-input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-calendar3 text-primary"></i></span>
                        <input type="date" name="CheckInDate" class="form-control border-start-0" value="2026-10-01">
                    </div>
                </div>

                <!-- Nút Tìm kiếm -->
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-custom w-100 py-2 mt-4 fw-bold shadow-sm" style="height: 42px;">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- NỬA DƯỚI: Danh sách địa điểm & khách sạn -->
<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark"><i class="bi bi-compass-fill text-primary"></i> Điểm đến phổ biến</h4>
        
    </div>

    <!-- Danh sách POI có Highlight -->
    <div class="row row-cols-2 row-cols-md-5 g-3 mb-5">
        @foreach (var poi in Model.Pois)
        {
            var isSelected = Model.SelectedPoi == poi.Name;
            <div class="col">
                <a href="/Index?SelectedPoi=@(isSelected ? "" : System.Net.WebUtility.UrlEncode(poi.Name))"
                   class="clickable-card position-relative shadow-sm rounded-3 overflow-hidden border @(isSelected ? "poi-card-active" : "")">

                    

                    <img src="@poi.ImageUrl" alt="@poi.Name" class="w-100 poi-card-img" />
                    <div class="poi-overlay text-white">
                        <div class="fw-bold small">@poi.Name</div>
                    </div>
                </a>
            </div>
        }
    </div>

    <!-- Tiêu đề danh sách kết quả -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-dark">
            @if (!string.IsNullOrEmpty(Model.SearchKeyword))
            {
                <span>Kết quả tìm kiếm cho: "@Model.SearchKeyword"</span>
            }
            else if (!string.IsNullOrEmpty(Model.SelectedPoi))
            {
                <span>Khách sạn gần @Model.SelectedPoi</span>
            }
            else
            {
                <span>Gợi ý khách sạn</span>
            }
        </h4>
        <span class="text-muted small">Tìm thấy @Model.Hotels.Count khách sạn</span>
    </div>

    <!-- Danh sách Khách sạn -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model.Hotels.Any())
        {
            @foreach (var hotel in Model.Hotels)
            {
                <div class="col">
                    <a href="/HotelDetails?id=@hotel.Id" class="clickable-card card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <img src="@hotel.ImageUrl" class="card-img-top" alt="@hotel.Name" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark mb-1">@hotel.Name</h5>
                            <p class="card-text text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger"></i> @hotel.FullAddress</p>
                            <p class="card-text small text-secondary mb-3"><i class="bi bi-telephone"></i> @hotel.Phone</p>

                            <div class="d-flex justify-content-between align-items-end mt-auto pt-2 border-top">
                                <div>
                                    <span class="text-muted small" style="font-size: 0.8rem;">Giá mỗi đêm từ</span>
                                    <div class="text-danger fw-bold fs-5">
                                        @(hotel.MinPrice > 0 ? $"{hotel.MinPrice:N0} VND" : "Liên hệ")
                                    </div>
                                </div>
                                <span class="badge bg-primary bg-opacity-10 text-primary p-2">9.0 Tuyệt vời</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center">
                <i class="bi bi-search text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-3">Không tìm thấy khách sạn nào khớp với từ khóa của bạn.</p>
            </div>
        }
    </div>
</div>